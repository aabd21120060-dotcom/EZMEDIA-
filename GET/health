app.get("/health", async (req, res) => {
  const database = await checkDatabase();

  res.status(200).json({
    platform: "EZ MEDIA",

    version: "11.0.0",

    status:
      database.ready
        ? "healthy"
        : "degraded",

    server: {
      online: true,

      node: process.version,

      environment:
        process.env.NODE_ENV ||
        "production",

      uptime: process.uptime()
    },

    database,

    features: {
      api: true,
      cms: true,
      storyObject: true,
      aiOrchestrator: true,
      workflowEngine: true,
      mediaLibrary: true,
      advertising: true,
      sponsorships: true,
      automation: true,
      worldRadar: false
    },

    timestamp:
      new Date().toISOString()
  });
});
